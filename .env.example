# Control Freak environment variables.
# Never commit real credentials. Platform-injected values override files.

# =============================================================================
# Required — all environments that talk to PostgreSQL
# =============================================================================
# PostgreSQL connection string (server-only). Never use NEXT_PUBLIC_ for this.
# Local Compose default (compose.yaml): user/password postgres, db oscal_control_tool.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oscal_control_tool

# Optional TLS override when the URL does not include sslmode=require.
# DATABASE_SSL=true

# =============================================================================
# Required — production runtime (NODE_ENV=production)
# =============================================================================
# Server-only signing secret for opaque sessions. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public base URL of the app (auth callbacks, cookies, invitation links).
# Set this to the HTTPS origin users actually open. Do not hard-code a host.
BETTER_AUTH_URL=http://localhost:3000

# Same public URL for the browser auth client. Optional at Docker build time
# (unset lets the client use the current origin). Set at runtime for the
# server if BETTER_AUTH_URL is unset. Only the non-secret public URL may use
# NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional extra CORS/CSRF origins (comma-separated). Better Auth also trusts
# BETTER_AUTH_URL. Example: https://app.example.com,https://www.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=

# Optional. When true, Better Auth trusts X-Forwarded-Host / X-Forwarded-Proto.
# Default off. Prefer an explicit BETTER_AUTH_URL instead.
# BETTER_AUTH_TRUSTED_PROXY_HEADERS=false

# Listen port. Cloud hosts typically inject PORT automatically.
# PORT=3000

# =============================================================================
# Deployment mode — production startup (npm start)
# =============================================================================
# Required values: normal | demo
# Omitted: defaults to normal (no demo data).
# Invalid values fail startup before migrations.
# DEPLOYMENT_MODE=normal

# =============================================================================
# Normal-only — optional initial administrator (DEPLOYMENT_MODE=normal)
# =============================================================================
# If all required variables below are set, production startup creates the
# administrator and organization idempotently. Existing users are not
# overwritten. If all are omitted, the app starts with no users (invite-only
# after an administrator exists). Partial sets fail closed.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
# BOOTSTRAP_ADMIN_NAME=Platform Admin
# BOOTSTRAP_ORG_NAME=Example Organization
# BOOTSTRAP_ORG_SLUG=example-organization

# =============================================================================
# Demo-only — required for DEPLOYMENT_MODE=demo (and local override)
# =============================================================================
# Shared password for canonical demo identities (alice@example.com, …).
# Required when DEPLOYMENT_MODE=demo or when seeding demo users in production.
# Must be at least 12 characters. Never logged. Local `bootstrap:demo` may
# use the documented local default when this is unset.
# DEMO_BOOTSTRAP_PASSWORD=

# =============================================================================
# Local-development-only
# =============================================================================
# Development-only email sink. Verification and invitation URLs are written
# here (JSON lines). Never used in production. Defaults to data/email-sink.json.
# TEST_EMAIL_SINK=./data/email-sink.json
#
# `next dev` also allows LAN host 192.168.211.160 (allowedDevOrigins). That
# list is omitted from production builds. Open http://192.168.211.160:3000
# only against a local `npm run dev` process.

# Local `npm run bootstrap:demo` writes .env.local and refuses remote databases.
# Do not use that command as a production entry point.

# =============================================================================
# Evidence object storage (Milestone 03B, ADR-025)
# =============================================================================
# Upload size limit in bytes (default 26214400 = 25 MiB). Enforced server-side.
# EVIDENCE_UPLOAD_MAX_BYTES=26214400
#
# Driver: "filesystem" (development/test only) or "s3" (required in production).
# When unset: filesystem outside production; s3 in production (fails closed if
# incomplete). Production startup validates this before the app listens.
# EVIDENCE_STORAGE_DRIVER=filesystem
# EVIDENCE_STORAGE_ROOT=./data/evidence-storage
#
# S3-compatible object storage (AWS S3, MinIO, Cloudflare R2, …). Required in
# production. Never commit real credentials.
# EVIDENCE_STORAGE_DRIVER=s3
# EVIDENCE_S3_BUCKET=control-freak-evidence
# EVIDENCE_S3_REGION=us-east-1
# EVIDENCE_S3_ACCESS_KEY_ID=
# EVIDENCE_S3_SECRET_ACCESS_KEY=
# Optional custom endpoint (MinIO / R2):
# EVIDENCE_S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# EVIDENCE_S3_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket:
# EVIDENCE_S3_KEY_PREFIX=prod

# =============================================================================
# Deprecated
# =============================================================================
# SEED_DEMO_PROJECT previously enabled a flagship-only production seed.
# Production startup no longer seeds from this flag. DEPLOYMENT_MODE=demo is
# authoritative. DEPLOYMENT_MODE=normal (or omitted) + SEED_DEMO_PROJECT=true
# fails startup. Lower-level `npm run db:seed:demo` still uses:
# SEED_DEMO_ORG_SLUG=canadian-goose-defence-system
# SEED_DEMO_PROJECT=true

# Legacy SQLite path (server-only). Used only when migrating or cutting over
# from the SQLite persistence layer; not used by the PostgreSQL application path.
# DATABASE_PATH=./data/oscal-control-tool.sqlite
